{
  "name": "nextjs-zoe",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:staging": "NEXT_PUBLIC_SANITY_DATASET=staging next dev",
    "dev:production": "NEXT_PUBLIC_SANITY_DATASET=production next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "lint": "eslint .",
    "audit:fix": "npm_config_cache=.npm-cache npm audit fix",
    "audit:deps": "npm_config_cache=.npm-cache npm audit --audit-level=low",
    "audit:updates": "node scripts/check-installable-updates.mjs",
    "health:runtime": "npm run typecheck && npm run lint && npm run build",
    "health:supplychain": "npm run health:deps:ci",
    "health:deps": "sh -c 'npm run audit:fix; audit_fix=$?; npm run audit:deps; audit_deps=$?; npm run audit:updates; audit_updates=$?; [ $audit_fix -eq 0 ] && [ $audit_deps -eq 0 ] && [ $audit_updates -eq 0 ]'",
    "health:deps:ci": "sh -c 'npm run audit:deps; audit_deps=$?; npm run audit:updates; audit_updates=$?; [ $audit_deps -eq 0 ] && [ $audit_updates -eq 0 ]'",
    "health": "npm run typecheck && npm run lint && npm run build && npm run health:deps",
    "health:ci": "npm run typecheck && npm run lint && npm run build && npm run health:deps:ci",
    "dev:port": "PORT=3005 next dev"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.0",
    "@portabletext/react": "^7.0.1",
    "@portabletext/types": "^4.0.1",
    "@sanity/client": "^7.14.0",
    "@sanity/image-url": "^2.0.2",
    "@sanity/types": "6.9.2",
    "@tailwindcss/postcss": "^4.1.18",
    "classnames": "^2.5.1",
    "framer-motion": "13.1.0",
    "lottie-react": "^2.4.1",
    "motion": "13.1.0",
    "next": "16.3.1",
    "next-sanity": "13.3.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-google-recaptcha": "^3.1.0",
    "resend": "6.20.0",
    "sass": "^1.97.2",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-google-recaptcha": "^2.1.9",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "@module-federation/vite": {
      "@module-federation/dts-plugin": "2.8.2"
    },
    "@vercel/frameworks": {
      "js-yaml": "5.2.3",
      "smol-toml": "1.7.1"
    },
    "typeid-js": {
      "uuid": "11.1.1"
    }
  }
}
